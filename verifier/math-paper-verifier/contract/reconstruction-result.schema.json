{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "reconstruction-result.v1"
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "supported",
        "contradicted",
        "unresolved"
      ]
    },
    "claimed_result": {
      "type": "string",
      "minLength": 1
    },
    "computed_result": {
      "type": "string"
    },
    "source_agreement": {
      "type": "string",
      "enum": [
        "matched",
        "mismatched",
        "not_checked",
        "not_applicable"
      ]
    },
    "convention_match": {
      "type": "string",
      "enum": [
        "demonstrated",
        "unresolved",
        "not_applicable"
      ]
    },
    "construction_match": {
      "type": "string",
      "enum": [
        "demonstrated",
        "unresolved",
        "not_applicable"
      ]
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "definition",
          "locator"
        ]
      },
      "minItems": 0
    },
    "derivation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "justification": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "step",
          "statement",
          "justification"
        ]
      },
      "minItems": 0
    },
    "model_identification": {
      "type": "string"
    },
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "analytic",
            "exact_symbolic",
            "numerical",
            "not_performed"
          ]
        },
        "expression": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "expression",
        "result"
      ]
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    },
    "consequence_status": {
      "type": "string",
      "enum": [
        "established",
        "unresolved",
        "not_applicable"
      ]
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "calculation",
              "convention",
              "construction",
              "source",
              "downstream",
              "other"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "detail"
        ]
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "description"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "target_id",
    "outcome",
    "claimed_result",
    "computed_result",
    "source_agreement",
    "convention_match",
    "construction_match",
    "conventions",
    "derivation",
    "model_identification",
    "calculation",
    "consequence",
    "consequence_status",
    "unresolved",
    "evidence"
  ]
}
